# Server
PORT=5001
NODE_ENV=development

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:3001

# Database (same PostgreSQL DB as patient backend)
DATABASE_URL="postgresql://user:password@localhost:5432/doclink"

# JWT
JWT_SECRET=your_super_secret_jwt_key_here
JWT_EXPIRES_IN=7d

# Tigris (or any S3-compatible) storage — verification document storage
# Tigris dashboard: https://storage.tigris.dev
S3_ENDPOINT=https://t3.storageapi.dev
S3_REGION=auto
S3_BUCKET_NAME=your_bucket_name
S3_ACCESS_KEY_ID=your_access_key_id
S3_SECRET_ACCESS_KEY=your_secret_access_key

# Retell AI webhook verification secret (sent in x-retell-signature header)
RETELL_WEBHOOK_SECRET=your_retell_webhook_secret_here

# Google Calendar availability sync (OAuth 2.0 Web client; enable Google Calendar API)
# Scopes used: calendar.events + calendar.readonly. Request offline access for a refresh token.
GOOGLE_CLIENT_ID=your_google_oauth_client_id
GOOGLE_CLIENT_SECRET=your_google_oauth_client_secret
# Must exactly match an Authorized redirect URI in the Google Cloud OAuth client.
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:5001/api/doctor/google/callback
# After OAuth, where to send the doctor's browser back in the app (availability page).
GOOGLE_OAUTH_SUCCESS_REDIRECT=http://localhost:3001/availability
# Key used to encrypt stored refresh tokens at rest (any long random string).
GOOGLE_TOKEN_ENC_KEY=your_long_random_token_encryption_key
