# Server
PORT=5001
NODE_ENV=development

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:3001

# Database (same PostgreSQL DB as patient backend)
DATABASE_URL="postgresql://user:password@localhost:5432/trimed_al"

# JWT
JWT_SECRET=your_super_secret_jwt_key_here
JWT_EXPIRES_IN=7d

# Uploads
UPLOAD_DIR=./uploads

# VAPI / Retell webhook verification secret
VAPI_WEBHOOK_SECRET=your_vapi_webhook_secret_here
