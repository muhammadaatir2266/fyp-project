# Patient API — port 5000
PORT=5000
NODE_ENV=development

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:3000

# Website URL (for CORS — centralized login lives here)
# IMPORTANT: JWT_SECRET must match the doctor backend so tokens issued here
# are valid across both patient and doctor APIs.
WEBSITE_URL=http://localhost:3003

# Database (shared PostgreSQL)
DATABASE_URL="postgresql://user:password@localhost:5432/doclink"

# JWT
JWT_SECRET=your_super_secret_jwt_key_here
JWT_EXPIRES_IN=7d

# n8n Chat Webhook
N8N_CHAT_WEBHOOK_URL=https://fyp2026.app.n8n.cloud/webhook/55479a0c-6a9f-4083-ad95-8cbe28d9e828

# Google Geocoding API — used to reverse-geocode GPS coordinates to city/locality names
# before sending to n8n. Enable "Geocoding API" in Google Cloud Console.
# If unset, raw "lat,lng" is sent as a fallback.
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# ML Model API (Python service)
ML_MODEL_API_URL=http://localhost:8000

# OpenAI (optional, for direct integration)
OPENAI_API_KEY=your_openai_api_key_here

# Retell AI — in-browser voice assistant
# When both are set, the "Call AI Assistant" button appears on doctor cards
# RETELL_API_KEY  — from Retell dashboard → API Keys
# RETELL_AGENT_ID — from Retell dashboard → Agents → select agent → copy ID
RETELL_API_KEY=your_retell_api_key_here
RETELL_AGENT_ID=your_retell_agent_id_here

# Google Calendar availability sync — must match the doctor backend's OAuth app.
# Patient backend only reads free/busy and writes events; no redirect URI needed.
GOOGLE_CLIENT_ID=your_google_oauth_client_id
GOOGLE_CLIENT_SECRET=your_google_oauth_client_secret
GOOGLE_TOKEN_ENC_KEY=your_long_random_token_encryption_key
