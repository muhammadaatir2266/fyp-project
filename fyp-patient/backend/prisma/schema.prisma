// Prisma Schema - Shared across all backends (patient, doctor, admin)
// Database: PostgreSQL

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ==================== ENUMS ====================

enum UserRole {
  PATIENT
  DOCTOR
  ADMIN
}

enum AppointmentStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
  NO_SHOW
}

enum BookingSource {
  PATIENT_APP
  CALLING_AGENT
  ADMIN_PANEL
  WALK_IN
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum DoctorVerificationStatus {
  PENDING
  APPROVED
  REJECTED
}

enum CallType {
  INCOMING
  OUTGOING
  MISSED
  VOICEMAIL
}

enum CallStatus {
  ACTIVE
  COMPLETED
  FAILED
}

enum CancelledBy {
  PATIENT
  DOCTOR
  ADMIN
}

// ==================== MODELS ====================

model User {
  id            String    @id @default(uuid())
  email         String    @unique
  password      String
  role          UserRole  @default(PATIENT)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  admin         Admin?
  patient       Patient?
  doctor        Doctor?
}

model Admin {
  id              String    @id @default(uuid())
  userId          String    @unique
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  firstName       String
  lastName        String
  phone           String?

  isSuperAdmin    Boolean   @default(false)
  isActive        Boolean   @default(true)

  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  apiTokens       ApiToken[]
}

model ApiToken {
  id              String    @id @default(uuid())
  name            String
  token           String    @unique
  adminId         String
  admin           Admin     @relation(fields: [adminId], references: [id], onDelete: Cascade)

  isActive        Boolean   @default(true)
  expiresAt       DateTime?
  lastUsedAt      DateTime?
  usageCount      Int       @default(0)

  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  apiLogs         ApiLog[]
}

model ApiLog {
  id              String    @id @default(uuid())
  tokenId         String
  token           ApiToken  @relation(fields: [tokenId], references: [id], onDelete: Cascade)

  endpoint        String
  method          String
  statusCode      Int
  requestBody     String?
  responseBody    String?
  ipAddress       String?
  userAgent       String?

  createdAt       DateTime  @default(now())
}

model Patient {
  id               String    @id @default(uuid())
  userId           String    @unique
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  firstName        String
  lastName         String
  dateOfBirth      DateTime?
  gender           Gender?
  phone            String?
  address          String?
  city             String?
  latitude         Float?
  longitude        Float?
  emergencyContact String?
  medicalHistory   String?
  allergies        String?

  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  appointments      Appointment[]
  patientSymptoms   PatientSymptom[]
  chatSessions      ChatSession[]
  reviews           DoctorReview[]
  callBookingIntents CallBookingIntent[]
}

model Doctor {
  id               String    @id @default(uuid())
  userId           String    @unique
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  firstName        String
  lastName         String
  specialtyId      String
  specialty        Specialty @relation(fields: [specialtyId], references: [id])

  phone            String
  address          String
  city             String
  clinicLocation   String?
  latitude         Float?
  longitude        Float?

  gender           Gender?
  languages        String[]  @default([])

  qualifications   String?
  experience       Int       @default(0)
  rating           Float     @default(0)
  reviewCount      Int       @default(0)
  consultationFee  Float?

  availableFrom    String?
  availableTo      String?
  workingDays      String[]
  unavailableDates String[]  @default([])

  // Verification fields
  licenseNumber        String?
  verificationDocument String?
  verificationStatus   DoctorVerificationStatus @default(PENDING)
  verificationNotes    String?
  verifiedAt           DateTime?
  verifiedBy           String?

  isActive         Boolean   @default(false)
  isVerified       Boolean   @default(false)

  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  appointments           Appointment[]
  callLogs               CallLog[]
  reviews                DoctorReview[]
  callBookingIntents     CallBookingIntent[]
  verificationDocuments  DoctorVerificationDocument[]
}

enum VerificationDocumentType {
  MEDICAL_LICENSE
  DEGREE_CERTIFICATE
  GOVERNMENT_ID
  OTHER
}

model DoctorVerificationDocument {
  id        String                   @id @default(uuid())
  doctorId  String
  doctor    Doctor                   @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  type      VerificationDocumentType
  s3Key     String
  fileName  String
  mimeType  String
  fileSize  Int
  createdAt DateTime                 @default(now())

  @@index([doctorId])
}

model Specialty {
  id          String    @id @default(uuid())
  name        String    @unique
  description String?
  iconName    String?
  aliases     String[]  @default([])

  doctors     Doctor[]
  diseases    Disease[]

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Symptom {
  id          String    @id @default(uuid())
  name        String    @unique
  description String?
  severity    Int       @default(1)

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  patientSymptoms  PatientSymptom[]
  diseaseSymptoms  DiseaseSymptom[]
}

model Disease {
  id                    String    @id @default(uuid())
  name                  String    @unique
  description           String?
  precautions           String[]
  recommendedSpecialtyId String?
  recommendedSpecialty  Specialty? @relation(fields: [recommendedSpecialtyId], references: [id], onDelete: SetNull)

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  diseaseSymptoms  DiseaseSymptom[]
  predictions      Prediction[]
}

model DiseaseSymptom {
  id        String  @id @default(uuid())
  diseaseId String
  disease   Disease @relation(fields: [diseaseId], references: [id], onDelete: Cascade)
  symptomId String
  symptom   Symptom @relation(fields: [symptomId], references: [id], onDelete: Cascade)
  weight    Float   @default(1.0)

  @@unique([diseaseId, symptomId])
}

model PatientSymptom {
  id            String   @id @default(uuid())
  patientId     String
  patient       Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)
  symptomId     String
  symptom       Symptom  @relation(fields: [symptomId], references: [id])
  severity      Int      @default(1)
  duration      String?
  notes         String?
  reportedAt    DateTime @default(now())
  chatSessionId String?
  chatSession   ChatSession? @relation(fields: [chatSessionId], references: [id], onDelete: SetNull)
}

model ChatSession {
  id        String    @id @default(uuid())
  patientId String
  patient   Patient   @relation(fields: [patientId], references: [id], onDelete: Cascade)
  startedAt DateTime  @default(now())
  endedAt   DateTime?

  // Stable key for n8n Postgres chat memory. Carries the guest UUID forward on
  // claim so the conversation thread continues across signup; null for sessions
  // created directly by authenticated users (falls back to id).
  memoryKey String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  messages        ChatMessage[]
  predictions     Prediction[]
  patientSymptoms PatientSymptom[]
}

model ChatMessage {
  id            String      @id @default(uuid())
  chatSessionId String
  chatSession   ChatSession @relation(fields: [chatSessionId], references: [id], onDelete: Cascade)
  role          String
  content       String
  createdAt     DateTime    @default(now())
}

model Prediction {
  id            String      @id @default(uuid())
  chatSessionId String
  chatSession   ChatSession @relation(fields: [chatSessionId], references: [id], onDelete: Cascade)
  diseaseId     String
  disease       Disease     @relation(fields: [diseaseId], references: [id])
  confidence    Float
  inputSymptoms String[]

  createdAt     DateTime    @default(now())
}

model Appointment {
  id          String            @id @default(uuid())
  patientId   String
  patient     Patient           @relation(fields: [patientId], references: [id], onDelete: Cascade)
  doctorId    String
  doctor      Doctor            @relation(fields: [doctorId], references: [id], onDelete: Cascade)

  scheduledAt  DateTime
  duration     Int               @default(30)
  status       AppointmentStatus @default(PENDING)
  source       BookingSource     @default(PATIENT_APP)
  reason       String?
  notes        String?
  cancelledBy  CancelledBy?
  confirmedAt  DateTime?

  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  review      DoctorReview?
}

model DoctorReview {
  id            String      @id @default(uuid())
  appointmentId String      @unique
  appointment   Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  patientId     String
  patient       Patient     @relation(fields: [patientId], references: [id], onDelete: Cascade)
  doctorId      String
  doctor        Doctor      @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  rating        Int
  comment       String?
  createdAt     DateTime    @default(now())

  @@index([doctorId, createdAt])
}

model CallLog {
  id          String     @id @default(uuid())
  doctorId    String
  doctor      Doctor     @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  callerName  String?
  callerPhone String
  callType    CallType
  status      CallStatus @default(COMPLETED)
  startedAt   DateTime   @default(now())
  endedAt     DateTime?
  duration    Int?
  summary     String?
  transcript  String?
  vapiCallId  String?

  createdAt   DateTime   @default(now())
}

model GuestChatSnapshot {
  id             String   @id @default(uuid())
  guestSessionId String   @unique
  predictions    Json
  symptoms       Json?
  specialty      String?
  messages       Json?
  expiresAt      DateTime
  createdAt      DateTime @default(now())

  @@index([expiresAt])
}

model CallBookingIntent {
  id           String   @id @default(uuid())
  patientId    String
  patient      Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)
  doctorId     String
  doctor       Doctor   @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  phone        String?
  retellCallId String?
  expiresAt    DateTime
  createdAt    DateTime @default(now())

  @@index([phone, expiresAt])
  @@index([patientId, doctorId, expiresAt])
}
